# Copie para .env somente no ambiente local. Nunca envie .env ao GitHub.
HOST=0.0.0.0
PORT=8080
APEX_DATA_DIR=./data

# Em hospedagem, defina um segredo aleatório com no mínimo 32 caracteres.
# Se ficar vazio, o servidor cria data/.jwt-secret localmente.
APEX_JWT_SECRET=

# Base reservada para configuração futura.
APEX_ENV=development
